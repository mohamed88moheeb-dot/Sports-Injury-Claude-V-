{
  "taxonomy_name": "rehab_composition_model",
  "version": "v1.0_scaffold",
  "approval_status": "pending",
  "executable": false,
  "runtime_integration": "none",
  "governance": "Taxonomy scaffold only. Metadata vocabulary for future use. Defines no dose, no progression, no readiness, no RTT/RTS clearance, no plan generation. Not wired into runtime.",
  "description": "Structure-only model for composing a future rehab day from governed blocks. Structure, not dosage. No block creates dose, progression, readiness, RTT, or RTS without future governed rules.",
  "categories": [
    {
      "id": "composition_sequence",
      "ordered_blocks": [
        "safety_check",
        "warm_up",
        "mobility_or_activation",
        "tissue_specific_loading",
        "strength_or_support_strength",
        "plyometric_or_mechanics_if_appropriate",
        "activity_exposure_if_appropriate",
        "assessment_or_checkin_gate_if_appropriate",
        "monitoring_instructions"
      ]
    },
    {
      "id": "composition_rules",
      "rules": [
        "structure_only_not_dosage",
        "each_block_pulls_from_its_named_knowledge_system",
        "no_block_creates_dose_progression_readiness_rtt_or_rts_without_future_governed_rules",
        "unknown_is_not_safe",
        "restricted_contexts_remain_restricted",
        "sport_name_does_not_directly_select_exercises"
      ]
    },
    {
      "id": "selection_inputs",
      "inputs": [
        "injury_module",
        "safety_state",
        "stage_or_capacity",
        "athlete_goals",
        "sport_demands",
        "available_equipment",
        "pain_response",
        "external_load",
        "assessment_evidence"
      ]
    }
  ],
  "note": "No dosage, progression authorization, readiness authorization, RTT/RTS clearance, or plan generation is created here."
}
