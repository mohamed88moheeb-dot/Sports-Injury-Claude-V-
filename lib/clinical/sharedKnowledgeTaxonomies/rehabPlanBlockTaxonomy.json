{
  "taxonomy_name": "rehab_plan_block",
  "version": "v1.0_scaffold",
  "approval_status": "pending",
  "executable": false,
  "runtime_integration": "none",
  "governance": "Taxonomy scaffold only. Metadata vocabulary for future use. Defines no dose, no progression, no readiness, no RTT/RTS clearance, no plan generation. Not wired into runtime.",
  "description": "Taxonomy of future rehab-plan blocks. Each block pulls from a named knowledge system; block selection is governed only by a future rule engine. Blocks define structure, never dose/progression/readiness/clearance.",
  "categories": [
    {
      "id": "safety_check",
      "pulls_from": "assessment_knowledge",
      "can_contain": "safety screens and gating evidence",
      "must_not_contain": "exercises, dose, or clearance",
      "selection_governed_by": "future_rule_engine_only"
    },
    {
      "id": "warm_up_general",
      "pulls_from": "exercise_knowledge",
      "can_contain": "general warm-up exercises",
      "must_not_contain": "tissue-specific load decisions or dose",
      "selection_governed_by": "future_rule_engine_only"
    },
    {
      "id": "warm_up_tissue_specific",
      "pulls_from": "exercise_knowledge",
      "can_contain": "tissue-specific warm-up exercises",
      "must_not_contain": "strength dose or clearance",
      "selection_governed_by": "future_rule_engine_only"
    },
    {
      "id": "mobility_block",
      "pulls_from": "exercise_knowledge",
      "can_contain": "mobility/dynamic-mobility exercises",
      "must_not_contain": "stretching dose or clearance",
      "selection_governed_by": "future_rule_engine_only"
    },
    {
      "id": "activation_block",
