      "must_not_contain": "fixed dose, progression, or clearance",
      "selection_governed_by": "future_rule_engine_only"
    },
    {
      "id": "strength_block",
      "pulls_from": "exercise_knowledge",
      "can_contain": "strength exercises",
      "must_not_contain": "fixed dose, progression, or clearance",
      "selection_governed_by": "future_rule_engine_only"
    },
    {
      "id": "support_strength_block",
      "pulls_from": "exercise_knowledge",
