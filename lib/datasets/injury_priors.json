{
  "_metadata": {
    "version": "1.0",
    "date": "2026-06-22",
    "description": "Bayesian prior probabilities for sports injuries, derived from epidemiological surveillance data. All base rates are expressed as probability (0.0–1.0) within the reference population of athletes presenting to emergency departments or sports medicine clinics with a musculoskeletal complaint in the specified body region.",
    "important_note": "These are NOT general population incidence rates. They are CONDITIONAL probabilities: P(injury | athlete presents with complaint in body region). This is the correct prior for Bayesian updating from symptom likelihood ratios.",
    "pubmed_attribution": "All data sourced from PubMed-indexed surveillance studies. DOIs provided.",
    "primary_sources": [
      {
        "label": "NEISS_pediatric_2015_2024",
        "description": "National Electronic Injury Surveillance System - pediatric lower extremity sports injuries",
        "citation": "Wong L et al. Orthop J Sports Med. 2026.",
        "doi": "https://doi.org/10.1177/23259671261416130",
        "pmid": "41732224",
        "n": "2,308,476 national injury estimates"
      },
      {
        "label": "HS_RIO_2015_2019",
        "description": "National High School Sports-Related Injury Surveillance Study",
        "citation": "Pizzarro J et al. Orthop J Sports Med. 2024.",
        "doi": "https://doi.org/10.1177/23259671241252637",
        "pmid": "38784790",
        "n": "15,531 injuries across 6,778,209 AEs"
      },
      {
        "label": "Ankle_Sprain_HSRIO_2011_2019",
        "description": "Ankle sprain epidemiology across 16 US high school sports",
        "citation": "Kerr ZY et al. J Athl Train. 2022.",
        "doi": "https://doi.org/10.4085/1062-6050-0664.21",
        "pmid": "35271730",
        "n": "9,320 ankle sprains"
      },
      {
        "label": "ACL_European_Football",
        "description": "ACL epidemiology in top 5 European football leagues 2018-2024",
        "citation": "Ortiz-Sánchez D et al. Orthop J Sports Med. 2026.",
        "doi": "https://doi.org/10.1177/23259671251400766",
        "pmid": "41510354"
      },
      {
        "label": "ACL_Mechanisms_SR",
        "description": "Sport-specific ACL injury mechanisms systematic review",
        "citation": "Sundberg A et al. Sports Med. 2025.",
        "doi": "https://doi.org/10.1007/s40279-025-02271-w",
        "pmid": "40690162"
      },
      {
        "label": "Sex_Differences_TeamSport",
        "description": "Sex differences in injury rates - meta-analysis 20 studies",
        "citation": "Zech A et al. J Sport Health Sci. 2021.",
        "doi": "https://doi.org/10.1016/j.jshs.2021.04.003",
        "pmid": "34052518"
      }
    ],
    "interpretation_guide": {
      "base_rate_general": "P(this injury | athlete presents with complaint in this body region), general sports-active population",
      "base_rate_by_sport": "Adjusted conditional probability given the specific sport context",
      "base_rate_by_mechanism": "Adjusted conditional probability given reported mechanism",
      "base_rate_by_sex": "Sex-stratified conditional probabilities where evidence exists",
      "confidence_intervals": "Where provided, these are 95% CI from source studies"
    }
  },
