{
  "_metadata": {
    "version": "1.0",
    "date": "2026-06-22",
    "description": "Evidence-based diagnostic weights for sports injury assessment questions. Likelihood ratios (LR) derived from validated clinical prediction rules and diagnostic accuracy studies retrieved from PubMed and Consensus AI.",
    "lr_interpretation": {
      "lr_above_10": "Large diagnostic shift; strong positive predictor",
      "lr_5_to_10": "Moderate diagnostic shift",
      "lr_2_to_5": "Small but useful diagnostic shift",
      "lr_below_2": "Minimal diagnostic value",
      "lr_below_0_1": "Strong negative predictor (rules out)",
      "lr_0_1_to_0_2": "Moderate negative predictor",
      "lr_0_2_to_0_5": "Small negative predictor"
    },
    "evidence_levels": {
      "A": "Systematic review or meta-analysis with published sensitivity/specificity",
      "B": "Prospective CPR validation or diagnostic cohort study",
      "C": "Single diagnostic accuracy study or retrospective cohort",
      "D": "Expert clinical consensus / derived from mechanism reasoning"
    },
    "pubmed_attribution": "All LR values sourced from PubMed-indexed literature. DOIs provided per article.",
    "sources": [
      {
        "label": "OAR_validation",
        "citation": "Morais B et al. Injury. 2021.",
